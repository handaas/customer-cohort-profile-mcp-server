# Default: local plans and stored snapshot reads only. No paid calls.
PORTRAIT_LIVE=0
PORTRAIT_TENANT=local
# PORTRAIT_DB_PATH=/private/service-state/portrait.sqlite3
PORTRAIT_PLAN_TTL_SECONDS=900
PORTRAIT_SNAPSHOT_TTL_SECONDS=604800
PORTRAIT_HTTP_HOST=127.0.0.1
PORTRAIT_HTTP_PORT=8000
# Behind a trusted TLS reverse proxy only; comma-separated exact values.
PORTRAIT_ALLOWED_HOSTS=
PORTRAIT_ALLOWED_ORIGINS=
CUSTOMER_COHORT_PROFILE_MCP_TOKEN=
INTEGRATOR_ID=
SECRET_ID=
SECRET_KEY=
